  "scripts": {
    "build": "nest build",
    "typecheck": "nest build --type-check --path tsconfig.typecheck.json",
    "auth:migrate": "pnpm dlx auth@latest generate --output=src/db/auth-schema.ts",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "format": "pnpm dlx oxfmt --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "serve": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --fix",
    "test": "vitest run --silent",
    "test:verbose": "vitest run",
    "test:watch": "vitest --silent",
    "test:watch:verbose": "vitest",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts --silent",
    "test:e2e:verbose": "vitest run --config ./vitest.config.e2e.ts",
    "test:app": "vitest run --silent=true test/app.e2e-spec.ts",
    "test:auth": "vitest run --silent=true test/auth/",
    "test:comments": "vitest run --silent=true test/comments/",
    "test:follows": "vitest run --silent=true test/follows/",
    "test:playground": "vitest run --silent=true test/playground/",
    "test:polls": "vitest run --silent=true test/polls/",
    "test:posts": "vitest run --silent=true test/posts/",
    "test:bookmarks": "vitest run --silent=true test/bookmarks/",
    "test:reactions": "vitest run --silent=true test/reactions/",
    "test:uploads": "vitest run --silent=true test/uploads/",
    "test:messages": "vitest run --silent=true test/messages/",
    "test:threads": "vitest run --silent=true test/threads/",
    "test:users": "vitest run --silent=true test/users/",
    "test:config": "vitest run --silent=true test/config/",
    "test:moderation": "vitest run --silent=true test/moderation/",
    "test:tags": "vitest run --silent=true test/tags/",
    "test:analytics": "vitest run --silent=true test/analytics/",
    "seed": "tsx seed.ts",
    "seed:watch": "tsx watch seed.ts"
  },
