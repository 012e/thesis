    "test:watch:verbose": "vitest",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts --silent",
    "test:e2e:verbose": "vitest run --config ./vitest.config.e2e.ts",
    "seed": "tsx seed.ts",
    "seed:watch": "tsx watch seed.ts"
  },
