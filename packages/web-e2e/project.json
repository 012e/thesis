{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/web-e2e",
  "projectType": "application",
  "tags": ["type:e2e", "scope:web"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --config=playwright.config.ts",
        "cwd": "packages/web-e2e"
      },
      "configurations": {
        "headed": {
          "command": "playwright test --config=playwright.config.ts --headed",
          "cwd": "packages/web-e2e"
        },
        "ui": {
          "command": "playwright test --config=playwright.config.ts --ui",
          "cwd": "packages/web-e2e"
        },
        "debug": {
          "command": "playwright test --config=playwright.config.ts --debug",
          "cwd": "packages/web-e2e"
        }
      }
    },
    "e2e-codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright codegen http://localhost:5173",
        "cwd": "packages/web-e2e"
      }
    },
    "show-report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright show-report",
        "cwd": "packages/web-e2e"
      }
    },
    "install-browsers": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright install --with-deps",
        "cwd": "packages/web-e2e"
      }
    }
  },
  "implicitDependencies": ["web"]
}
