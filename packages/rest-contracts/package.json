{
  "name": "@repo/rest-contracts",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "typecheck": "tsgo --noEmit",
    "lint": "echo 'No lint configured for rest-contracts' && exit 0",
    "test": "echo 'No tests configured for rest-contracts' && exit 0"
  },
  "dependencies": {
    "@repo/shared-dto": "workspace:*",
    "@ts-rest/core": "3.53.0-rc.1",
    "@ts-rest/nest": "3.53.0-rc.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsdown": "^0.22.1",
    "typescript": "^5.9.3"
  }
}
