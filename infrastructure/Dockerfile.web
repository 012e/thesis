# =============================================================================
# Dockerfile.web — React 19 + Vite SPA served by nginx
# Build context: repo root  (docker build -f infrastructure/Dockerfile.web .)
#
# VITE_ vars are baked into the JS bundle at build time — pass them via
# --build-arg (or the compose `args:` section) before the image is built.
# =============================================================================

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# -----------------------------------------------------------------------------
# Stage: deps
# -----------------------------------------------------------------------------
FROM base AS deps
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./

COPY apps/web/package.json                apps/web/
COPY packages/rest-contracts/package.json packages/rest-contracts/
COPY packages/shared-dto/package.json     packages/shared-dto/
COPY packages/auth-client/package.json    packages/auth-client/

RUN pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage: builder
# -----------------------------------------------------------------------------
FROM deps AS builder
WORKDIR /app

# Build-time env vars (VITE_ prefix — baked into the bundle)
ARG VITE_BACKEND_URL=http://localhost:3001
ARG VITE_MASTRA_CHAT_URL=http://localhost:4111/chat

ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_MASTRA_CHAT_URL=$VITE_MASTRA_CHAT_URL

COPY apps/web                apps/web
COPY packages/rest-contracts packages/rest-contracts
COPY packages/shared-dto     packages/shared-dto
COPY packages/auth-client    packages/auth-client

# Build shared packages
RUN pnpm --filter @repo/shared-dto     build
RUN pnpm --filter @repo/auth-client    build
RUN pnpm --filter @repo/rest-contracts build

# Build the Vite SPA
RUN pnpm --filter web build

# -----------------------------------------------------------------------------
# Stage: runner — static files served by nginx
# -----------------------------------------------------------------------------
FROM nginx:alpine AS runner

COPY infrastructure/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
