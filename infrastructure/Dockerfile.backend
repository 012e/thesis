# =============================================================================
# Dockerfile.backend — NestJS API
# Build context: repo root  (docker build -f infrastructure/Dockerfile.backend .)
# =============================================================================

FROM node:lts-krypton AS base
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# -----------------------------------------------------------------------------
# Stage: deps — install all workspace dependencies
# -----------------------------------------------------------------------------
FROM base AS deps
WORKDIR /app

# Copy manifests only first so the layer is cached until they change
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./

# Workspace package manifests
COPY apps/backend/package.json            apps/backend/
COPY packages/rest-contracts/package.json packages/rest-contracts/
COPY packages/shared-dto/package.json     packages/shared-dto/
COPY packages/auth-client/package.json    packages/auth-client/

RUN pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage: builder — compile all packages then the backend
# -----------------------------------------------------------------------------
FROM deps AS builder
WORKDIR /app

# Copy source
COPY apps/backend   apps/backend
COPY packages/rest-contracts packages/rest-contracts
COPY packages/shared-dto     packages/shared-dto
COPY packages/auth-client    packages/auth-client

# Build shared packages in dependency order
RUN pnpm --filter @repo/shared-dto     build
RUN pnpm --filter @repo/auth-client    build
RUN pnpm --filter @repo/rest-contracts build

# Build NestJS backend
RUN pnpm --filter backend build

# -----------------------------------------------------------------------------
# Stage: runner — lean production image
# -----------------------------------------------------------------------------
FROM base AS runner
WORKDIR /app

# Install all deps (drizzle-kit is a devDependency and is needed for migrations)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./
COPY apps/backend/package.json            apps/backend/
COPY packages/rest-contracts/package.json packages/rest-contracts/
COPY packages/shared-dto/package.json     packages/shared-dto/
COPY packages/auth-client/package.json    packages/auth-client/

RUN pnpm install --frozen-lockfile

# Copy compiled backend
COPY --from=builder /app/apps/backend/dist apps/backend/dist

# Copy compiled workspace packages needed at runtime
COPY --from=builder /app/packages/rest-contracts/dist packages/rest-contracts/dist
COPY --from=builder /app/packages/shared-dto/dist     packages/shared-dto/dist
COPY --from=builder /app/packages/auth-client/dist    packages/auth-client/dist

# Copy DB migrations
COPY --from=builder /app/apps/backend/drizzle apps/backend/drizzle
COPY --from=builder /app/apps/backend/drizzle.config.ts apps/backend/drizzle.config.ts

# Copy static assets bundled by nest-cli (e.g. default-profile-image.jpg)
COPY --from=builder /app/apps/backend/dist/users apps/backend/dist/users

ENV NODE_ENV=production

EXPOSE 3000

# Run migrations via the package.json script, then start the server
CMD ["node", "apps/backend/dist/main.js"]
