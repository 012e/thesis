# =============================================================================
# Dockerfile.backend — NestJS API
# Build context: repo root  (docker build -f infrastructure/Dockerfile.backend .)
# =============================================================================

# Ubuntu 24.04 (Noble) ships glibc 2.39, required by microsandbox native bindings
FROM ubuntu:24.04 AS base
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl ca-certificates gnupg libdbus-1-3 \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# -----------------------------------------------------------------------------
# Stage: deps — install all workspace dependencies
# -----------------------------------------------------------------------------
FROM base AS deps
WORKDIR /app

# Copy manifests only first so the layer is cached until they change
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./

# Workspace package manifests
COPY apps/backend/package.json            apps/backend/
COPY packages/rest-contracts/package.json packages/rest-contracts/
COPY packages/shared-dto/package.json     packages/shared-dto/
COPY packages/auth-client/package.json    packages/auth-client/

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage: builder — compile all packages then the backend
# -----------------------------------------------------------------------------
FROM deps AS builder
WORKDIR /app

# Copy source
COPY apps/backend   apps/backend
COPY packages/rest-contracts packages/rest-contracts
COPY packages/shared-dto     packages/shared-dto
COPY packages/auth-client    packages/auth-client

# Build shared packages in dependency order
RUN pnpm --filter @repo/shared-dto     build
RUN pnpm --filter @repo/auth-client    build
RUN pnpm --filter @repo/rest-contracts build

# Build NestJS backend
RUN pnpm --filter backend build

# -----------------------------------------------------------------------------
# Stage: deploy — isolated production package via pnpm deploy
# -----------------------------------------------------------------------------
FROM builder AS deploy
WORKDIR /app

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm --filter backend --prod deploy /deploy && \
    cp -r apps/backend/dist /deploy/dist && \
    cp -r apps/backend/drizzle /deploy/drizzle && \
    cp apps/backend/drizzle.config.ts /deploy/drizzle.config.ts

# -----------------------------------------------------------------------------
# Stage: runner — lean production image
# -----------------------------------------------------------------------------
FROM base AS runner
WORKDIR /app

COPY --from=deploy /deploy .

ENV NODE_ENV=production

EXPOSE 3000

CMD ["node", "dist/main.js"]
