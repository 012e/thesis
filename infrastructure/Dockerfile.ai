# =============================================================================
# Dockerfile.ai — Mastra AI agent service
# Build context: repo root  (docker build -f infrastructure/Dockerfile.ai .)
# =============================================================================

FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# -----------------------------------------------------------------------------
# Stage: deps
# -----------------------------------------------------------------------------
FROM base AS deps
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./

COPY apps/ai/package.json            apps/ai/
COPY packages/shared-dto/package.json packages/shared-dto/

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage: builder — mastra build produces .mastra/output/index.mjs
# -----------------------------------------------------------------------------
FROM deps AS builder
WORKDIR /app

COPY apps/ai         apps/ai
COPY packages/shared-dto packages/shared-dto

RUN pnpm --filter @repo/shared-dto build

WORKDIR /app/apps/ai
RUN pnpm mastra build

# -----------------------------------------------------------------------------
# Stage: deploy — isolated production package via pnpm deploy
# -----------------------------------------------------------------------------
FROM builder AS deploy
WORKDIR /app

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm --filter ai --prod deploy /deploy && \
    cp -r apps/ai/.mastra /deploy/.mastra

# -----------------------------------------------------------------------------
# Stage: runner
# -----------------------------------------------------------------------------
FROM base AS runner
WORKDIR /app

COPY --from=deploy /deploy .

ENV NODE_ENV=production

EXPOSE 4111

CMD ["node", ".mastra/output/index.mjs"]
