# =============================================================================
# Dockerfile.ai — Mastra AI agent service
# Build context: repo root  (docker build -f infrastructure/Dockerfile.ai .)
# =============================================================================

FROM node:24-alpine AS base
WORKDIR /app
COPY package.json ./
RUN corepack enable && corepack prepare "$(node -p "require('./package.json').packageManager")" --activate
# Install uv so that `uvx` is available at runtime for stdio MCP servers (e.g. duckduckgo-mcp-server)
RUN apk add --no-cache uv

# -----------------------------------------------------------------------------
# Stage: deps
# -----------------------------------------------------------------------------
FROM base AS deps

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./

COPY apps/ai/package.json            apps/ai/
COPY packages/shared-dto/package.json packages/shared-dto/

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage: builder — mastra build produces .mastra/output/index.mjs
# -----------------------------------------------------------------------------
FROM deps AS builder
WORKDIR /app

COPY apps/ai         apps/ai
COPY packages/shared-dto packages/shared-dto

RUN pnpm --filter @repo/shared-dto build

WORKDIR /app/apps/ai
RUN pnpm mastra build

# -----------------------------------------------------------------------------
# Stage: runner
# -----------------------------------------------------------------------------
FROM base AS runner
WORKDIR /app

# Install only production deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/ai/package.json             apps/ai/
COPY packages/shared-dto/package.json packages/shared-dto/

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prod

# Copy the bundled Mastra output and shared-dto dist
COPY --from=builder /app/apps/ai/.mastra    apps/ai/.mastra
COPY --from=builder /app/packages/shared-dto/dist packages/shared-dto/dist

ENV NODE_ENV=production

EXPOSE 4111

CMD ["node", "apps/ai/.mastra/output/index.mjs"]
