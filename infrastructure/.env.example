# =============================================================================
# infrastructure/.env.example
# Copy to .env and fill in values before running docker compose.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL / ParadeDB)
# ---------------------------------------------------------------------------
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=database

# ---------------------------------------------------------------------------
# Better Auth
# Generate a strong secret: openssl rand -base64 32
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=changeme_generate_a_real_secret_here_32chars

# ---------------------------------------------------------------------------
# Public URLs — used for CORS, cookies, and links returned to clients.
# Set these to the actual external URL for each service.
# In Dokploy these are typically your domain / subdomain assignments.
# ---------------------------------------------------------------------------
BACKEND_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:80
AI_PUBLIC_URL=http://localhost:4111

# ---------------------------------------------------------------------------
# MinIO / object storage
# ---------------------------------------------------------------------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=posts-images
# MINIO_PUBLIC_URL is the URL clients use to load images (browser-facing)
MINIO_PUBLIC_URL=http://localhost:9000

# ---------------------------------------------------------------------------
# OpenAI — required by the Mastra AI service
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
