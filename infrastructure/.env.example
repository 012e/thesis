# =============================================================================
# infrastructure/.env.example
# Copy to .env and fill in values before deploying via Dokploy.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL / ParadeDB)
# ---------------------------------------------------------------------------
POSTGRES_USER=username
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=thesis

# ---------------------------------------------------------------------------
# Better Auth
# Generate a strong secret: openssl rand -base64 32
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=changeme_generate_a_real_secret_here_32chars

# ---------------------------------------------------------------------------
# Public URLs — must match the domains configured in Traefik / Dokploy.
# Used for CORS, auth cookies, and URLs returned to clients.
# ---------------------------------------------------------------------------
BACKEND_PUBLIC_URL=https://api.toin.dev
WEB_PUBLIC_URL=https://toin.dev
AI_PUBLIC_URL=https://ai.toin.dev

# ---------------------------------------------------------------------------
# MinIO / object storage
# MINIO_PUBLIC_URL is the browser-facing URL used to load uploaded images.
# ---------------------------------------------------------------------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_strong_minio_password
MINIO_BUCKET=posts-images
MINIO_PUBLIC_URL=https://minio.toin.dev

# ---------------------------------------------------------------------------
# OpenAI — required by the Mastra AI service
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Judge0 — code execution engine
# Generate strong passwords: openssl rand -base64 32
# ---------------------------------------------------------------------------
JUDGE0_REDIS_PASSWORD=change_me_judge0_redis_password
JUDGE0_POSTGRES_PASSWORD=change_me_judge0_postgres_password
